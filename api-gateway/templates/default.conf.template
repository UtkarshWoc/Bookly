# =====================================================================
#  api-gateway — the only public entry point of Bookly.
#  Rendered from the root .env at container start.
# =====================================================================

uninitialized_variable_warn off;

# ---------- Rate limiting ----------
limit_req_zone $binary_remote_addr zone=auth_login:10m rate=${LOGIN_RATE_LIMIT};
limit_req_status 429;

# ---------- Upstreams ----------
upstream auth_service {
    server auth-service:${AUTH_SERVICE_PORT};
    keepalive 16;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 1m;

    # Identity defaults to empty; only auth_request (auth-required.conf) fills it.
    set $bookly_user_id "";
    set $bookly_user_role "";

    # Consistent JSON errors for responses generated by nginx itself
    # (upstream error responses are passed through untouched).
    error_page 401 = @unauthorized;
    error_page 403 = @forbidden;
    error_page 429 = @rate_limited;
    error_page 500 502 503 504 = @upstream_unavailable;

    # ---------- Auth offloading subrequest ----------
    location = /_auth_verify {
        internal;
        proxy_pass http://auth_service/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ---------- auth-service ----------
    location = /api/auth/login {
        limit_req zone=auth_login burst=${LOGIN_RATE_BURST} nodelay;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://auth_service/login;
    }

    location /api/auth/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://auth_service/;
    }

    # ---------- Gateway ----------
    location = /api/health {
        default_type application/json;
        return 200 '{"service":"api-gateway","status":"ok"}';
    }

    location /api/ {
        default_type application/json;
        return 404 '{"error":{"status":404,"message":"No API route matches this path"}}';
    }

    # ---------- Named error locations ----------
    location @unauthorized {
        default_type application/json;
        add_header X-Request-Id $request_id always;
        return 401 '{"error":{"status":401,"message":"Authentication required: token missing, invalid, expired or revoked"}}';
    }
    location @forbidden {
        default_type application/json;
        add_header X-Request-Id $request_id always;
        return 403 '{"error":{"status":403,"message":"Forbidden"}}';
    }
    location @rate_limited {
        default_type application/json;
        add_header X-Request-Id $request_id always;
        add_header Retry-After 60 always;
        return 429 '{"error":{"status":429,"message":"Too many requests, slow down and try again shortly"}}';
    }
    location @upstream_unavailable {
        default_type application/json;
        add_header X-Request-Id $request_id always;
        return 503 '{"error":{"status":503,"message":"Upstream service unavailable"}}';
    }
}
