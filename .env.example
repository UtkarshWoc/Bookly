# ======================================================================
#  Bookly — single source of configuration for every container.
#  Copy to `.env` (cp .env.example .env) and adjust as needed.
#  docker-compose reads this file both for ${VAR} interpolation and as
#  the env_file of every service, so each value is defined exactly once.
# ======================================================================

# ---------- General ----------
COMPOSE_PROJECT_NAME=bookly
NODE_ENV=production
LOG_LEVEL=info

# ---------- api-gateway (nginx) ----------
GATEWAY_PORT=8080
# dev-only gRPC proxy (grpc_pass) to seat-service, bound to 127.0.0.1
GRPC_GATEWAY_PORT=9090
LOGIN_RATE_LIMIT=5r/m
LOGIN_RATE_BURST=3
API_RATE_LIMIT=20r/s
GATEWAY_EVENTS_CACHE_SECONDS=15

# ---------- Shared infrastructure ----------
MONGO_URI=mongodb://mongo:27017
MONGO_PORT=27017
REDIS_PORT=6379

# ---------- auth-service ----------
AUTH_SERVICE_PORT=8001
AUTH_DB_NAME=bookly_auth
AUTH_REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
ADMIN_NAME=Bookly Admin
ADMIN_EMAIL=admin@bookly.dev
ADMIN_PASSWORD=Admin@12345

# ---------- event-service ----------
EVENT_SERVICE_PORT=8002
EVENT_DB_NAME=bookly_events
EVENT_REDIS_URL=redis://redis:6379/1
EVENT_CACHE_TTL_SECONDS=60
SEED_EVENTS=true

# ---------- seat-service (gRPC, internal) ----------
SEAT_SERVICE_PORT=50051
SEAT_DB_NAME=bookly_seats
SEAT_REDIS_URL=redis://redis:6379/2
SEAT_LOCK_TTL_SECONDS=300

# ---------- booking-service ----------
BOOKING_SERVICE_PORT=8003
BOOKING_REPLICAS=2
BOOKING_DB_NAME=bookly_bookings
BOOKING_REDIS_URL=redis://redis:6379/3
SEAT_SERVICE_ADDR=seat-service:50051
EVENT_SERVICE_URL=http://event-service:8002
EVENT_SERVICE_TIMEOUT_MS=2000
GRPC_DEADLINE_MS=2000
GRPC_MAX_RETRIES=2
IDEMPOTENCY_TTL_SECONDS=86400
MAX_SEATS_PER_BOOKING=8
PAYMENT_LATENCY_MS=700
PAYMENT_DECLINE_CARD=4000000000000002

# ---------- notification-service ----------
NOTIFICATION_SERVICE_PORT=8004
NOTIFICATION_DB_NAME=bookly_notifications
NOTIFICATION_REDIS_URL=redis://redis:6379/4

# ---------- Event bus (Redis Pub/Sub) ----------
BOOKING_EVENTS_CHANNEL=bookly.bookings

# ---------- frontend (Next.js) ----------
FRONTEND_PORT=3000
# Used only by `npm run dev` in /frontend to proxy /api/* to the gateway
API_GATEWAY_URL=http://localhost:8080
